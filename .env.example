# Copy to .env and fill in. Never commit .env.

# Anthropic API key: needed only for discovery (the LLM run) and the agent demo. Replay never uses it.
ANTHROPIC_API_KEY=

# Fixed service-account login for the self-hosted ParaBank (never a per-request input)
PARABANK_BASE_URL=http://localhost:8080/parabank
PARABANK_USERNAME=agentdemo
PARABANK_PASSWORD=

# Optional, normally left unset:
# Name recorded on any escalation ticket a CLI replay resolves (empty = unattributed).
# CUA_OPERATOR=
# Fault injection for the capability service (a live HTTP fault test). Read once at startup, never from a
# request; a set value prints a loud banner. Format: transient_fail:<step>:<url glob>[:<delay_ms>] or clear_session:<step>
# CUA_FAULT=
